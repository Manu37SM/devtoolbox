{
  "name": "@devtoolbox/backend",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "postinstall": "prisma generate",
    "dev": "dotenv -e ../.env -- nest start --watch",
    "build": "nest build",
    "start": "cross-env NODE_ENV=production dotenv -e ../.env -- node dist/backend/src/main.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "jest --passWithNoTests",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "db:migrate": "dotenv -e ../.env -- prisma migrate deploy",
    "db:migrate:dev": "dotenv -e ../.env -- prisma migrate dev",
    "db:seed": "dotenv -e ../.env -- tsx src/database/seeds/index.ts",
    "db:studio": "dotenv -e ../.env -- prisma studio"
  },
  "jest": {
    "moduleFileExtensions": ["js", "json", "ts"],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "moduleNameMapper": {
      "^@devtoolbox/shared$": "<rootDir>/../../packages/shared/src/index.ts"
    },
    "testEnvironment": "node"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.28.0",
    "@devtoolbox/shared": "*",
    "@nestjs/bullmq": "^11.0.4",
    "@nestjs/common": "^11.1.28",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^11.1.28",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/passport": "^11.0.0",
    "@nestjs/platform-express": "^11.1.28",
    "@nestjs/throttler": "^6.2.0",
    "@node-saml/node-saml": "^5.0.1",
    "@prisma/client": "^5.20.0",
    "argon2": "^0.41.0",
    "bullmq": "^5.15.0",
    "cheerio": "^1.2.0",
    "cookie-parser": "^1.4.7",
    "helmet": "^8.0.0",
    "ioredis": "^5.4.0",
    "jose": "^5.9.6",
    "nanoid": "^3.3.7",
    "passport-jwt": "^4.0.0",
    "razorpay": "^2.9.4",
    "resend": "^4.0.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.24",
    "@nestjs/testing": "^11.1.28",
    "@types/cookie-parser": "^1.4.7",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.14",
    "@types/passport-jwt": "^4.0.1",
    "cross-env": "^7.0.3",
    "dotenv-cli": "^7.4.0",
    "eslint": "^9.11.0",
    "jest": "^29.7.0",
    "prisma": "^5.20.0",
    "supertest": "^7.0.0",
    "ts-jest": "^29.4.12",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
