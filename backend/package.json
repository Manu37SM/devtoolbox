    "bullmq": "^5.15.0",
    "ioredis": "^5.4.0",
    "passport-jwt": "^4.0.0",
    "passport-github2": "^0.1.0",
    "passport-google-oauth20": "^2.0.0",
    "argon2": "^0.41.0",
