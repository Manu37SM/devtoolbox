{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "types": ["node"],
    "module": "Node16",
    "moduleResolution": "Node16",
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "outDir": "./dist",
    "rootDir": "..",
    "paths": {
      "@devtoolbox/shared": ["../packages/shared/src"]
    }
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
