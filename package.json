{
  "name": "devtoolbox",
  "private": true,
  "version": "0.0.0",
  "packageManager": "npm@10.9.0",
  "workspaces": [
    "frontend",
    "backend",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "db:migrate": "npm run db:migrate --workspace backend",
    "db:migrate:dev": "npm run db:migrate:dev --workspace backend",
    "db:seed": "npm run db:seed --workspace backend",
    "generate:tool": "tsx scripts/generate-tool.ts",
    "prepare": "husky"
  },
  "devDependencies": {
    "eslint": "^9.11.0",
    "husky": "^9.1.0",
    "lint-staged": "^15.2.0",
    "prettier": "^3.3.0",
    "tsx": "^4.19.0",
    "turbo": "^2.10.10",
    "typescript": "^5.6.0"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{md,json,css}": [
      "prettier --write"
    ]
  }
}
