{
  "name": "devtoolbox",
  "private": true,
  "version": "0.0.0",
  "packageManager": "npm@10.9.0",
  "workspaces": [
    "frontend",
    "backend",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "db:migrate": "npm run db:migrate --workspace backend",
    "db:migrate:dev": "npm run db:migrate:dev --workspace backend",
    "generate:tool": "tsx scripts/generate-tool.ts"
  },
  "devDependencies": {
    "eslint": "^10.9.1",
    "prettier": "^3.3.0",
    "tsx": "^4.19.0",
    "turbo": "^2.10.11",
    "typescript": "^5.6.0"
  }
}
