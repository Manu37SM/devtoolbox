# See DEVELOPMENT_GUIDE.md §9 for details on each variable.
# Copy to .env and fill in local values. Never commit a real .env file.

# ── Backend ───────────────────────────────────────────────
NODE_ENV=development
PORT=4000
# Port 5433, not Postgres's default 5432 — avoids clashing with a
# locally-installed Postgres some dev machines already have running there
# (see docker-compose.yml's postgres service for why).
DATABASE_URL=postgresql://devtoolbox:devtoolbox@localhost:5433/devtoolbox
REDIS_URL=redis://localhost:6379

JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
# CSRF double-submit-cookie HMAC secret (checklist item #22 — see
# backend/src/common/csrf/csrf.ts). Falls back to JWT_ACCESS_SECRET if
# unset so this isn't a hard-boot-failure like the other secrets above, but
# a dedicated value should be set in production. Generate with:
# openssl rand -base64 32
CSRF_SECRET=
# Cloudflare Turnstile secret key (checklist item #12 — bot protection on
# register/login/password-reset). Free, no usage cap for standard traffic.
# Create at https://dash.cloudflare.com/?to=/:account/turnstile. Leave
# blank to skip captcha verification entirely (see captcha.service.ts) —
# fine for local dev, should be set in production.
TURNSTILE_SECRET_KEY=
# 32+ byte key for AES-256-GCM encryption of synced history previews at rest
# (DATABASE.md §4). Generate with: openssl rand -base64 32
HISTORY_ENCRYPTION_KEY=
FRONTEND_URL=http://localhost:3000
# This backend's own externally-reachable origin — only needed for the SAML
# ACS callback URL (API.md §17.5), which must be an absolute URL an IdP's
# dashboard is configured with ahead of time. Defaults to localhost:4000 if
# unset; must be set to the real deployed backend URL in production.
BACKEND_URL=http://localhost:4000

# Org SSO (AUDIT_REPORT.md §23): AES-256-GCM master key for encrypting
# SsoConnection.oidcClientSecretEnc at rest — same shape as
# HISTORY_ENCRYPTION_KEY but a separate key. Generate with: openssl rand -base64 32
SSO_SECRET_ENCRYPTION_KEY=

ANTHROPIC_API_KEY=
# Model names for the AI Gateway's two tiers (ARCHITECTURE.md §8.3) — env-
# configurable so a model rename/deprecation is a config change, not a
# code change. Defaults shown; override per deployment as needed.
AI_MODEL_HAIKU=claude-haiku-4-5
AI_MODEL_SONNET=claude-sonnet-4-5

OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=

# Client ID is not secret (only the secret is) — it's also exposed to the
# frontend below as NEXT_PUBLIC_GITHUB_CLIENT_ID/NEXT_PUBLIC_GOOGLE_CLIENT_ID
# so the browser can build the provider's own authorize URL directly
# (frontend/src/lib/oauth.ts). Keep both pairs' client-id values identical —
# they're the same OAuth app registration, read from two places.
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Leave blank in dev — verify-email/password-reset links are logged to the
# backend console instead of actually sent (see email.service.ts). Required
# for production.
RESEND_API_KEY=
EMAIL_FROM=DevToolbox <noreply@devtoolbox.dev>

# Error tracking (AUDIT_REPORT.md §24) — leave blank in dev; GlobalExceptionFilter
# only reports true 5xx/unhandled errors, never request bodies (CLAUDE.md
# rule 8). Required for production observability, not required to boot.
SENTRY_DSN=

# Billing (ARCHITECTURE.md §14.2) — leave all blank in dev; /billing/* routes
# return 503 without RAZORPAY_KEY_ID/RAZORPAY_KEY_SECRET (same
# "clearly-fail rather than silently no-op" pattern as
# ANTHROPIC_API_KEY/RESEND_API_KEY above). Migrated off Stripe — Stripe
# doesn't support billing for this business from India (AUDIT_REPORT.md
# §20). RAZORPAY_PLAN_ID_PRO/TEAM are Razorpay Plan IDs (created in the
# Razorpay dashboard), not rupee amounts — pricing changes don't need a
# deploy.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_PLAN_ID_PRO=
RAZORPAY_PLAN_ID_TEAM=

# ── Frontend ──────────────────────────────────────────────
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000/v1
# Your deployed frontend's own public URL — used to build robots.txt's
# sitemap link and every URL listed in sitemap.xml (frontend/src/app/robots.ts,
# sitemap.ts). No trailing slash. Defaults to a placeholder if unset, so this
# should be set for the real deploy but isn't required for local dev.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Same DSN as backend's SENTRY_DSN (one Sentry project covers both, or use
# two — either works, this just needs to be set to reach the frontend's
# client bundle). Also leave blank in dev. sentry.client.config.ts's
# beforeSend strips request bodies before anything is sent — see that file.
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_ANALYTICS_HOST=
# Same value as GITHUB_OAUTH_CLIENT_ID/GOOGLE_OAUTH_CLIENT_ID above — leave
# blank to hide the corresponding "Continue with ..." button (oauth.ts
# checks these before building the authorize URL).
NEXT_PUBLIC_GITHUB_CLIENT_ID=
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
# Cloudflare Turnstile site key (public, pairs with backend's
# TURNSTILE_SECRET_KEY above) — renders the captcha widget on the
# register/login/password-reset forms (TurnstileWidget.tsx). Leaving this
# blank just means no widget renders and the backend skips verification
# (dev-safe default).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
