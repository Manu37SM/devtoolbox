{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "Node16",
    "moduleResolution": "Node16",
    "outDir": "./dist",
    // ".." (not "./src") — same fix as backend/tsconfig.json: this package
    // imports @devtoolbox/shared's .ts source directly (no build step for
    // that package), so rootDir must cover both packages/cli/src and
    // packages/shared/src, or tsc errors that the shared file is "not
    // under rootDir".
    "rootDir": "..",
    "paths": {
      "@devtoolbox/shared": ["../shared/src"]
    }
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
